<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Convenção de escrita do Dynamic Study Planner.

  ESTE ARQUIVO DESCREVE O QUE O CÓDIGO JÁ FAZ, e não um guia de estilo importado de fora.

  A etapa 04 mediu o repositório e encontrou formatação internamente consistente: 4 espaços de
  recuo em 100% dos arquivos, zero tabulações, e percentil 99 de comprimento de linha em 121
  caracteres. O que faltava não era disciplina — era algo que travasse a disciplina existente.

  Por isso NÃO foi adotado um formatador que reescreve o código (Spotless com google-java-format
  ou palantir): rodá-lo produziria um diff de ~3.700 linhas, apagaria o `git blame` de quase todo
  o repositório e não melhoraria a leitura de nada, já que a formatação atual é uniforme. A escolha
  foi um VERIFICADOR configurado com a convenção medida.

  Rodar:   mvn checkstyle:check      (falha o build quando alguma regra é violada)
  Relatório: mvn checkstyle:checkstyle

  Ver docs/qualidade/04b-correcao-escrita.md, seção 1, para o raciocínio completo.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Arquivo termina com quebra de linha; nenhuma tabulação. -->
    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter"/>

    <!-- Percentil 99 medido: 121 caracteres. 120 é a convenção que o código já pratica. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package .*|^import .*|^\s*\*\s*@see .*|https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- Imports: nada morto, nada com asterisco. -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- Estrutura de bloco. Um `if` sem chaves é onde a próxima linha adicionada se perde. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="EmptyCatchBlock"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>

        <!-- Defeitos que o compilador não pega. -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- Nomenclatura. `log` minúsculo é a convenção do SLF4J e está deliberadamente aceito
             em ConstantName. -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="PackageName"/>

        <!-- Limiares de complexidade. Os valores são o estado MEDIDO após a etapa 04b, não uma
             aspiração: hoje o pior método está em 8 e o maior tem 20 linhas executáveis. Servem de
             catraca — quem passar deles precisa justificar, não descobrir depois. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedTryDepth"/>
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
        </module>

        <!-- Idioma: ver ADR-0007. Identificadores e mensagens de API em inglês; explicação em
             português. Nenhuma regra do Checkstyle verifica idioma, então isto é só um lembrete
             de onde a convenção está escrita. -->
    </module>
</module>
